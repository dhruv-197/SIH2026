# ------------------------------------------------------------------------------
# Node.js & Frontend Tooling
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Frontend build caches & SSR artifacts
.vite/
frontend/.vite/
dist-ssr/
frontend/dist-ssr/

# Node debug and process logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Note on frontend/dist:
# frontend/dist is intentionally tracked so the FastAPI backend can serve
# the full compiled dashboard out-of-the-box without requiring Node.js.

# ------------------------------------------------------------------------------
# SQLite & Database Lock / Temporary Files
# ------------------------------------------------------------------------------
# Note: Primary databases (geothermal.db, geothermal_sentinel.gpkg) are kept
# so the system boots offline with pre-ingested FIRMS and ESA WorldCover baseline.
# Only transient runtime WAL, SHM, and temporary lock files are excluded.
*.db-wal
*.db-shm
*.db-journal
*.tmp
backend/app/data/*.db-wal
backend/app/data/*.db-shm
backend/app/data/gis/*.tmp
backend/app/data/archive/*/*.db-wal
backend/app/data/archive/*/*.db-shm
backend/app/data/archive/*/gis/*.tmp

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
