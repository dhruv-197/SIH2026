# ==============================================================================
# GeoThermal Sentinel - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & File System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs, Code Editors & Tooling
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
.claude/

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
MANIFEST
/build/
/dist/
backend/build/
backend/dist/
downloads/
eggs/
.eggs/
share/python-wheels/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Coverage & Type Checking
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
